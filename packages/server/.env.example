# Copy this file to .env and adjust as needed. .env itself is gitignored --
# never commit real secrets or environment-specific values.

# Port to listen on. Hosting platforms usually set this for you.
PORT=3001

# Only used when the client is served from a different origin, which is the
# case in local development (Vite serves it on 5173). In a deployment the
# server serves the client itself, so this is ignored.
CLIENT_ORIGIN=http://localhost:5173

# Where the built client lives. Defaults to packages/client/dist, which is
# correct for both local runs and the Docker image; set it only if you lay
# the files out differently.
# CLIENT_DIST=/app/packages/client/dist
